# E-Paper Dashboard - Environment Variables
# Copy this file to .env.local and fill in your values
# Never commit the populated .env.local file

# =============================================================================
# Exchange Rate API (Required for FX data)
# =============================================================================
# Get your API key from: https://exchangerate.host
EXCHANGERATE_API_KEY=your_api_key_here

# =============================================================================
# Power Outage Schedule (Optional - defaults to group 1.1)
# =============================================================================
# Yasno power outage group ID for your area
# Valid values: "1.1", "1.2", "2.1", "2.2", "3.1", "3.2", "4.1", "4.2", "5.1", "5.2", "6.1", "6.2"
YASNO_GROUP_ID=1.1

# =============================================================================
# Deye Cloud API (Optional - for backup power monitoring)
# =============================================================================
# Register at: https://eu1-developer.deyecloud.com
# Create an application to get your App ID

# App ID from Deye developer portal
DEYE_APP_ID=your_app_id_here

# App Secret from Deye developer portal
DEYE_APP_SECRET=your_app_secret_here

# Your Deye Cloud account email (same as mobile app)
DEYE_EMAIL=your_email@example.com

# Your Deye Cloud account password (will be SHA256 hashed)
DEYE_PASSWORD=your_password_here

# Your Hashed Deye Cloud account password (for production)
DEYE_PASSWORD_HASHED=your_password_here

# Device serial number (found in Deye Cloud mobile app under device settings)
DEYE_DEVICE_SN=your_device_serial_number
